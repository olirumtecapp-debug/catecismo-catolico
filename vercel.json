{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/contact/:path*",
      "destination": "/api/contact"
    },
    {
      "source": "/api/admin/liturgia/:path*",
      "destination": "/api/admin/liturgia"
    },
    {
      "source": "/auditoria",
      "destination": "/auditoria.html"
    },
    {
      "source": "/preceitos",
      "destination": "/preceitos.html"
    },
    {
      "source": "/((?!assets/|data/|api/|auditoria|preceitos|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/img/santos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}